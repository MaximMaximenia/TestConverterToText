# config.php хранит токен бота — закрыт от прямых запросов по ссылке.
# lead.php остаётся доступен, это и есть сам API-эндпоинт.
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>
